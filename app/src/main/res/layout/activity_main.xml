<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- กล่องหัวข้อหลัก (มีเส้นขอบ) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_border_box"
            android:backgroundTint="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="บันทึกค่าใช้จ่ายประจำวัน"
                android:textColor="#2D2D2D"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="จดทุกบาทที่ใช้ไว้วันนี้ให้ครบเลยนะ ✨"
                android:textColor="#888888"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- การ์ดฟอร์มกรอกข้อมูล (มีเส้นขอบ) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:strokeColor="#F48FB1"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- ป้ายกำกับช่องจำนวนเงิน -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="จำนวนเงิน (บาท)"
                    android:textColor="#4A4A4A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- ช่องกรอกจำนวนเงิน (มีเส้นขอบ) -->
                <EditText
                    android:id="@+id/etAmount"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_border_box"
                    android:backgroundTint="#FFF5F7"
                    android:hint="เช่น 100-200"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="16dp"
                    android:textColor="#2D2D2D"
                    android:textColorHint="#B09A9E"
                    android:textSize="16sp" />

                <!-- ป้ายกำกับคำอธิบาย -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="รายละเอียดรายการ"
                    android:textColor="#4A4A4A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- ช่องกรอกคำอธิบาย (มีเส้นขอบ) -->
                <EditText
                    android:id="@+id/etNote"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_border_box"
                    android:backgroundTint="#FFF5F7"
                    android:hint="เช่น ข้าวของเครื่องใช้"
                    android:inputType="text"
                    android:paddingHorizontal="16dp"
                    android:textColor="#2D2D2D"
                    android:textColorHint="#B09A9E"
                    android:textSize="16sp" />

                <!-- แถวปุ่มกด (มีเส้นขอบทั้ง 2 ปุ่ม) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClear"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="#FCE4EC"
                        android:text="เคลียร์"
                        android:textColor="#D81B60"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp"
                        app:strokeColor="#F48FB1"
                        app:strokeWidth="1.5dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAdd"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1.3"
                        android:backgroundTint="#EC407A"
                        android:text="+ เพิ่มรายการ"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp"
                        app:strokeColor="#AD1457"
                        app:strokeWidth="1.5dp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- การ์ดสรุปผลด้านล่าง (มีเส้นขอบ) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:strokeColor="#F48FB1"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="สรุปการใช้จ่าย"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- กล่องแสดงรายการล่าสุด (มีเส้นขอบ) -->
                <TextView
                    android:id="@+id/tvLastItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_border_box"
                    android:backgroundTint="#FAFAFA"
                    android:padding="12dp"
                    android:text="รายการล่าสุด: -"
                    android:textColor="#555555"
                    android:textSize="14sp" />

                <!-- กล่องแสดงยอดรวม (มีเส้นขอบ) -->
                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_border_box"
                    android:backgroundTint="#FFF0F3"
                    android:padding="14dp"
                    android:text="ยอดรวมวันนี้: 0.00 บาท"
                    android:textColor="#D81B60"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>